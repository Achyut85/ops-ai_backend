
 // use prisma-next

model Organization {
  id        Int               @id @default(autoincrement())
  name      String

  account   OrganizationAccount?
  users     User[]
  tickets   Ticket[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model OrganizationAccount {
  id             Int               @id @default(autoincrement())
  email          String            @unique
  passwordHash   String

  organizationId Int               @unique
  organization   Organization      @relation(fields: [organizationId], references: [id])

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model User {
  id              Int               @id @default(autoincrement())
  username        String
  passwordHash    String
  email           String?
  name            String?
  role            String
  status          String

  organizationId  Int
  organization    Organization      @relation(fields: [organizationId], references: [id])

  assignedTickets Ticket[]

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([organizationId, username])
}

model Ticket {
  id             Int               @id @default(autoincrement())
  title          String
  description    String?
  status         String

  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id])

  assignedUserId Int?
  assignedUser   User?             @relation(fields: [assignedUserId], references: [id])

  history        TicketHistory[]

  deletedAt      TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model TicketHistory {
  id             Int               @id @default(autoincrement())

  organizationId Int
  organization   Organization      @relation(
    fields: [organizationId],
    references: [id]
  )

  ticketId       Int
  ticket         Ticket            @relation(
    fields: [ticketId],
    references: [id]
  )

  actorId        Int
  actorType      String

  action         String
  oldStatus      String?
  newStatus      String?
  oldAssignedUserId Int?
  newAssignedUserId Int?

  createdAt      TimestamptzString @default(now())
}

model RefreshSession {
  id             Int               @id @default(autoincrement())
  familyId       String
  tokenHash      String            @unique
  actorId        Int
  actorType      String
  organizationId Int
  expiresAt      TimestamptzString
  absoluteExpiresAt TimestamptzString?
  revokedAt      TimestamptzString?
  createdAt      TimestamptzString @default(now())

  @@index([familyId])
  @@index([actorId, actorType, organizationId])
  @@index([expiresAt])
}